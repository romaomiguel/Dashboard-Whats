# Evolution API — server-only, nunca prefixar com NEXT_PUBLIC_
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que compõe o caminho do webhook: /api/webhooks/evolution/<WEBHOOK_SECRET>
# Gerar com: openssl rand -hex 24
WEBHOOK_SECRET=

# Endereço público do app, usado para dizer à Evolution onde entregar o
# webhook. Na Vercel não precisa: o domínio é descoberto em tempo de execução.
# Defina APP_URL se usar domínio próprio ou publicar em outro lugar.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=https://seu-dominio.com
